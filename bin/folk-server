<?php
/**
 * Folk server entry point for Laravel (extension mode).
 *
 * Main thread: starts server + enters worker loop.
 * ZTS worker threads: skip server start (bridge state already initialized).
 */

declare(strict_types=1);

$autoload = $GLOBALS['_composer_autoload_path']
    ?? dirname(__DIR__, 4) . '/vendor/autoload.php';

if (!file_exists($autoload)) {
    fwrite(STDERR, "folk-server: vendor/autoload.php not found.\n");
    exit(1);
}

require $autoload;

$configPath = $argv[1] ?? 'folk.toml';

if (!function_exists('folk_version')) {
    fwrite(STDERR, "Error: folk extension is not loaded.\n");
    exit(1);
}

// ZTS worker threads already have bridge state; skip server start.
if (!folk_is_worker_thread()) {
    $server = new Folk\Server($configPath);
    $server->start();
}

// Bootstrap Laravel (registers handlers via service provider).
// Derive project root from autoload path (works in ZTS where getcwd may differ)
$projectRoot = dirname($autoload, 2);
$app = require $projectRoot . '/bootstrap/app.php';
$app->make(\Illuminate\Contracts\Console\Kernel::class)->bootstrap();

// Create the worker loop and register handlers.
$loop = new \Folk\Sdk\Worker\WorkerLoop();

if (isset($GLOBALS['folk_worker_boot_hook'])) {
    ($GLOBALS['folk_worker_boot_hook'])($loop);
}

$loop->run();
